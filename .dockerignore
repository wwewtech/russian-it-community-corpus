# Keep build context small and hermetic: raw exports, datasets and
# weights live on HF Hub / are generated by `python main.py`, never baked.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage*
*.egg-info/
.git/
.venv/
venv/
env/
# Local secrets must never enter the build context (see docs/adr/0001-hf-token-handling.md)
.env
.env.*
.hf_cache/
.pre-commit-cache/
.idea/
.vscode/
ChatExport_*/
*.mp4
*.ogg
*.gif
*.jpg
*.png
dataset_output/parquet/*.parquet
dataset_output/jsonl/*.jsonl
lora_adapters/**/*.safetensors
lora_adapters/**/checkpoint-*/
outputs/
checkpoints/
*.log
.DS_Store
