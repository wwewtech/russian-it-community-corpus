# .env.example
# Copy to .env and fill in your values
# DO NOT commit .env to version control!

# Hugging Face Hub token (for gated models, dataset/model pushes)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: Weights & Biases for experiment tracking
WANDB_API_KEY=
WANDB_PROJECT=russian-it-community-corpus

# Optional: Prefect Cloud for orchestration
PREFECT_API_KEY=
PREFECT_API_URL=https://api.prefect.cloud

# Optional: Docker registry (if not using GHCR)
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Optional: GPU/Cloud provider credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: Monitoring/Observability
SENTRY_DSN=
GRAFANA_CLOUD_API_KEY=
PROMETHEUS_REMOTE_WRITE_URL=

# Optional: Database connections (if using external stores)
POSTGRES_DSN=
REDIS_URL=
CLICKHOUSE_URL=

# Optional: Telegram bot for notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=